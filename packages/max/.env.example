# Agent Max — local environment template.
#
# Copy this file to `packages/max/.env` (gitignored) and fill in your values.
# Loaded automatically by src/config.ts when present — no extra flags needed.
# CI uses GitHub Actions secrets instead; this file is purely for local runs.

# --- GitHub (required) ---
GITHUB_TOKEN=
GITHUB_OWNER=Bojack70
GITHUB_REPO=PromptFuel

# --- Email digest (required) ---
# Get RESEND_API_KEY from https://resend.com/api-keys
RESEND_API_KEY=
REPORT_EMAIL=faiz.b99@gmail.com

# --- Dev.to (required) ---
# https://dev.to/settings/extensions → "DEV Community API Keys"
DEVTO_API_KEY=

# --- Bluesky (required for publishing) ---
# App password from https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=natevoss.bsky.social
BLUESKY_APP_PASSWORD=

# --- Reddit (optional — API route is on hold) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Mastodon (optional — not currently used) ---
MASTODON_ACCESS_TOKEN=
MASTODON_INSTANCE_URL=https://fosstodon.org

# --- LLM routing (optional — defaults are safe) ---
# cli (default): uses Claude Code subscription via `claude -p` subprocess ($0)
# api:           uses paid Anthropic API — requires ANTHROPIC_API_KEY, isolated from subscription
# MAX_LLM_MODE=cli
# ANTHROPIC_API_KEY=

# --- Paths (optional) ---
# MAX_DATA_DIR=packages/max/data
